<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:ShootPorter.App.Properties"
        xmlns:suki="using:SukiUI.Controls"
        x:Class="ShootPorter.App.Views.ExistingFileDialog"
        Title="{x:Static p:Resources.FileAlreadyExists}"
        Width="560" SizeToContent="Height"
        CanMinimize="False" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="{x:Static p:Resources.FileAlreadyExists}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="{x:Static p:Resources.ThisFileIsAlreadyInThe}" Opacity="0.8"/>
        <TextBlock x:Name="PathText" TextWrapping="Wrap"
                   FontFamily="Consolas,Courier New,monospace" FontSize="12"/>

        <WrapPanel HorizontalAlignment="Right">
            <Button Content="{x:Static p:Resources.CancelDownload}" Classes="Flat" Margin="0,0,8,8" Click="Cancel_Click"/>
            <Button Content="{x:Static p:Resources.AddSuffixToAll}" Classes="Flat" Margin="0,0,8,8" Click="AddSuffixAll_Click"/>
            <Button Content="{x:Static p:Resources.AddSuffix}" Classes="Flat" Margin="0,0,8,8" Click="AddSuffix_Click"/>
            <Button Content="{x:Static p:Resources.OverwriteAll}" Classes="Flat" Margin="0,0,8,8" Click="OverwriteAll_Click"/>
            <Button Content="{x:Static p:Resources.Overwrite}" Classes="Flat Accent" Margin="0,0,0,8" Click="Overwrite_Click"/>
        </WrapPanel>
    </StackPanel>
</suki:SukiWindow>
