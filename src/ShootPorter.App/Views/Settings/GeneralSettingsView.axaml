<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:ShootPorter.App.Properties"
             xmlns:vm="using:ShootPorter.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="using:SukiUI.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="ShootPorter.App.Views.Settings.GeneralSettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="16">
        <StackPanel>
            <TextBlock Text="{x:Static p:Resources.GeneralPreferences}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static p:Resources.DeviceConnectionAndFileHandlingRules}" Opacity="0.6" FontSize="13"/>
        </StackPanel>

        <suki:GlassCard>
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Static p:Resources.Application}" FontWeight="SemiBold" FontSize="14"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch IsChecked="{Binding CheckForUpdates}" OnContent="" OffContent=""/>
                    <TextBlock Text="{x:Static p:Resources.CheckForUpdatesOnStartup}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="{x:Static p:Resources.CheckForUpdatesNow}" Command="{Binding CheckForUpdatesNowCommand}"/>
                    <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </suki:GlassCard>

        <suki:GlassCard>
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Static p:Resources.ImageSource}" FontWeight="SemiBold" FontSize="14"/>
                <RadioButton Content="{x:Static p:Resources.AutoDetectCameraOrCardReader}" IsChecked="{Binding IsAutoDetect}" GroupName="ImageSource"/>
                <RadioButton Content="{x:Static p:Resources.CameraUSBConnected}" IsChecked="{Binding IsCameraUsb}" GroupName="ImageSource"/>
                <RadioButton Content="{x:Static p:Resources.CardReaderOrExternalStorage}" IsChecked="{Binding IsCardReader}" GroupName="ImageSource"/>
            </StackPanel>
        </suki:GlassCard>
        
        <suki:GlassCard>
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Static p:Resources.FileHandling}" FontWeight="SemiBold" FontSize="14"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch IsChecked="{Binding UseCaptureTime}" OnContent="" OffContent=""/>
                    <TextBlock Text="{x:Static p:Resources.UseCaptureTimeForFileTimestamp}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch IsChecked="{Binding VideoTimeIsLocal}" OnContent="" OffContent=""/>
                    <TextBlock Text="{x:Static p:Resources.VideoTimeIsLocalTimeOff}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch IsChecked="{Binding AutoRotateJpegs}" OnContent="" OffContent=""/>
                    <TextBlock Text="{x:Static p:Resources.AutoRotateJPEGsLossless}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch IsChecked="{Binding ConvertToLowerCase}" OnContent="" OffContent=""/>
                    <TextBlock Text="{x:Static p:Resources.ConvertFilenameToLowerCase}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
