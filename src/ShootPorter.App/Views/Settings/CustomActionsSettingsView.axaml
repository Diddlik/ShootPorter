<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:ShootPorter.App.Properties"
             xmlns:vm="using:ShootPorter.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="using:SukiUI.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="ShootPorter.App.Views.Settings.CustomActionsSettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="16">
        <StackPanel>
            <TextBlock Text="{x:Static p:Resources.CustomActions}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static p:Resources.ConfigurePostDownloadScripts}" Opacity="0.6" FontSize="13"/>
        </StackPanel>

        <suki:GlassCard>
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch IsChecked="{Binding EnableCustomButton}" OnContent="" OffContent=""/>
                    <TextBlock Text="{x:Static p:Resources.EnableCustomButton}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="6" IsEnabled="{Binding EnableCustomButton}">
                    <TextBlock Text="{x:Static p:Resources.ButtonCaption}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding CustomButtonCaption}"/>
                </StackPanel>

                <StackPanel Spacing="6" IsEnabled="{Binding EnableCustomButton}">
                    <TextBlock Text="{x:Static p:Resources.CommandLineScript}" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox Text="{Binding CustomScriptPath}" FontFamily="Consolas,Courier New,monospace"/>
                        <Button Grid.Column="1" Content="{x:Static p:Resources.Browse}" Classes="Flat"
                                Click="BrowseScript_Click"/>
                    </Grid>
                    <TextBlock Text="{x:Static p:Resources.ScriptReceivesFFilePathAnd}"
                               Opacity="0.5" FontSize="11" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </suki:GlassCard>

        <suki:GlassCard>
            <StackPanel Spacing="16">
                <TextBlock Text="{x:Static p:Resources.AfterDownload}" FontWeight="SemiBold" FontSize="14"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch IsChecked="{Binding CreateSubfolders}" OnContent="" OffContent=""/>
                    <TextBlock Text="{x:Static p:Resources.CreateSubfoldersNextToDownloadedFiles}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Spacing="6" IsEnabled="{Binding CreateSubfolders}">
                    <TextBlock Text="{x:Static p:Resources.SubfolderNamesCommaSeparated}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SubfolderNames}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch IsChecked="{Binding ConvertToDng}" OnContent="" OffContent=""/>
                    <TextBlock Text="{x:Static p:Resources.ConvertRAWFilesToDNGAdobe}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Spacing="6" IsEnabled="{Binding ConvertToDng}">
                    <TextBlock Text="{x:Static p:Resources.DNGConverterPathEmptyDefaultInstall}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding DngConverterPath}" FontFamily="Consolas,Courier New,monospace"/>
                </StackPanel>
            </StackPanel>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
